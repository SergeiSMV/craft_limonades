# Шаблон переменных окружения. Скопировать в .env и заменить на свои значения:
# cp .env.example .env
# Файл .env в репозиторий не коммитится (секреты).

# --- PostgreSQL ---
POSTGRES_USER=wms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=craft_wms
POSTGRES_PORT=5432          # порт БД, публикуемый на хост (для psql / GUI-клиентов)

# --- HTTP: точка входа через nginx ---
HTTP_PORT=8080              # стек доступен снаружи по http://localhost:${HTTP_PORT}

# --- Backend (Go-сервис) ---
LOG_LEVEL=info             # уровень логирования: debug | info | warn | error

# --- Auth (P0-04) ---
JWT_SECRET=change_me_to_a_long_random_string   # секрет подписи JWT; в проде обязательно задать
ACCESS_TTL=12h             # время жизни access-токена
REFRESH_TTL=720h           # время жизни refresh-токена (720h = 30 дней)
ADMIN_BADGE=1000000012345678   # бейдж стартового админа: 16 цифр = логин(8) + секрет(8); замените!
ADMIN_FULL_NAME=Администратор  # ФИО стартового админа (для отчётов)

# --- Auth: admin по логину/паролю (P1-01-1, вход со смартфона/web) ---
# Опционально: если заданы оба — make seed создаёт admin с входом по username+паролю.
ADMIN_USERNAME=admin           # логин admin (>= 3 символов); пусто = не создавать
ADMIN_PASSWORD=change_me_please # пароль admin (>= 8 символов); задайте свой
