[Unit]
# Разовый бэкап БД Craft WMS: pg_dump из контейнера → gzip в BACKUP_DIR, ротация старых.
# Запускается таймером craft-wms-backup.timer. __REPO_ROOT__ подставляет deploy/install.sh.
Description=Craft WMS database backup (pg_dump + rotation)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
ExecStart=/bin/bash __REPO_ROOT__/deploy/pg-backup.sh
