# Настройки тестового стенда. stand.sh при первом запуске копирует этот файл в stand.env
# (вне git) и подставляет свой JWT-секрет. Править — stand.env, не этот шаблон.

# --- Откуда снимать снимок боевой базы (stand.sh pull) ---
STAND_PROD_SSH=sergeismv@192.168.0.106   # SSH к боевому серверу; пускает только из LAN
STAND_PROD_PROJECT=craft-wms             # compose-проект прода (name: в docker-compose.prod.yml)
STAND_KEEP_SNAPSHOTS=5                   # сколько последних снимков хранить

# --- Порты стенда на этой машине ---
STAND_HTTP_PORT=8090                     # портал и API: http://localhost:8090, ТСД — http://<IP Mac>:8090
STAND_DB_PORT=5433                       # psql: 127.0.0.1:5433, пользователь wms, пароль stand

# --- Бэкенд ---
STAND_LOG_LEVEL=debug
STAND_JWT_SECRET=                        # пусто — stand.sh сгенерирует при первом запуске

# --- Честный знак (ADHOC-54): stand.sh cz-setup включает и заполняет сам ---
STAND_CZ=off                             # on — бэкенд стенда читает ЧЗ через подписант прода (SSH-туннель)
STAND_CZ_SSH=                            # пусто — cz-tunnel@<хост из STAND_PROD_SSH>
STAND_CZ_OWNER_INN=                      # ИНН организации в ЧЗ, как CZ_OWNER_INN на проде
