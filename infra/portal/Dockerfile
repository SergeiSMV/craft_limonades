# Образ-контейнер для бандла веб-портала. Ничего не запускает: сервер достаёт из него
# файлы (docker create + docker cp) и раскладывает в каталог, откуда их отдаёт хостовый nginx.
#
# Почему образ, а не артефакт CI и не Release-ассет:
#   · GHCR с прод-сервера доступен и уже используется (backend тянется оттуда), тогда как
#     Docker Hub из России отваливается по TLS - это проверено на бою;
#   · авторизация в GHCR на сервере уже настроена;
#   · артефакты Actions однажды упёрлись в квоту хранилища, из-за чего их и отключили.
#
# scratch, а не nginx/alpine: контейнер не поднимается, значит базовый образ не нужен вовсе.
# Так в GHCR лежит ровно бандл и ничего сверх него.
FROM scratch

# Каталог фиксирован: deploy/_lib.sh достаёт файлы именно отсюда.
COPY web /portal

# Команда-заглушка. Не выполняется никогда: сервер делает `docker create` и сразу `docker cp`,
# контейнер не запускается. Но без CMD `docker create` отказывается создавать контейнер
# ("no command specified") - проверено, образ без неё нерабочий.
CMD ["/portal"]
