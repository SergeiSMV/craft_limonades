# --- Craft WMS · ПРОД/ПИЛОТ окружение ---
# Скопировать в infra/.env.prod и заполнить РЕАЛЬНЫМИ значениями:
#   cp infra/.env.prod.example infra/.env.prod
# Файл infra/.env.prod в репозиторий НЕ коммитится (в .gitignore) — это боевые секреты.
#
# Портируемость: один и тот же compose/скрипты работают на любом сервере —
# меняется ТОЛЬКО этот файл. Ничего среды-специфичного в код/конфиги не зашито.

# === Домен и TLS (для deploy/10-nginx-vhost.sh: хостовый nginx + certbot) ===
DEPLOY_DOMAIN=craft.example.ru           # ваш домен; A-запись должна указывать на внешний IP сервера
CERTBOT_EMAIL=admin@example.ru           # e-mail для Let's Encrypt (уведомления об истечении серта)

# === Привязка backend (куда хостовый nginx проксирует) ===
# loopback = наружу не смотрит; достучится только локальный nginx. Не менять без причины.
BACKEND_BIND=127.0.0.1:8080

# === Образ backend из GHCR ===
# Имя фиксировано CI: ghcr.io/<owner-в-нижнем-регистре>/craft-wms-backend
# Тег: :main (прод) / :dev / :<sha> (пин конкретной сборки — рекомендуется для прода).
BACKEND_IMAGE=ghcr.io/sergeismv/craft-wms-backend:main

# === PostgreSQL ===
POSTGRES_USER=wms
POSTGRES_PASSWORD=CHANGE_ME_надёжный_пароль
POSTGRES_DB=craft_wms

# === Backend ===
LOG_LEVEL=info                           # debug | info | warn | error
JWT_SECRET=CHANGE_ME                      # сгенерировать: openssl rand -base64 48
ACCESS_TTL=12h
REFRESH_TTL=720h                          # 720h = 30 дней

# === Стартовый админ (используется ОДИН раз скриптом seed) ===
ADMIN_BADGE=1000000012345678             # бейдж: 16 цифр = логин(8) + секрет(8); замените!
ADMIN_FULL_NAME=Администратор
ADMIN_USERNAME=admin                     # вход по логину/паролю (>= 3 символов)
ADMIN_PASSWORD=CHANGE_ME_min8            # пароль admin (>= 8 символов)

# === Ресурсные лимиты (опционально) ===
DB_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=256m
