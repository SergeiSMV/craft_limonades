# =====================================================================
#  Craft WMS · конфигурация прод-сервера
# =====================================================================
#  ВАЖНО: комментарии — ТОЛЬКО на отдельной строке (как здесь).
#  НЕ писать комментарий в одной строке со значением — сломает конфиг.
#  Правильно:   DEPLOY_DOMAIN=craft.skogi.ru
#  Неправильно: DEPLOY_DOMAIN=craft.skogi.ru   # мой домен
#
#  Этот файл кладётся на сервер как /opt/craft-wms/.env.prod и в git НЕ попадает.
#  Значения ниже с CHANGE_ME / example — заменить на свои.
# =====================================================================

# --- Домен и e-mail для TLS (Let's Encrypt) ---
DEPLOY_DOMAIN=craft.example.ru
CERTBOT_EMAIL=admin@example.ru

# --- Образ backend из GHCR ---
# Прод тянет тег :main (обновляется при мерже dev -> main).
# Owner — в нижнем регистре. Оставьте :main, если не знаете, что делаете.
BACKEND_IMAGE=ghcr.io/sergeismv/craft-wms-backend:main

# --- Куда хостовый nginx проксирует backend (loopback, наружу не смотрит) ---
BACKEND_BIND=127.0.0.1:8080

# --- Веб-портал (Flutter Web) ---
# Каталог, из которого nginx отдаёт портал на корне домена; API живёт под /api/ (ADR-0015).
# Пусто = <каталог рядом с .env.prod>/portal.
PORTAL_ROOT=/opt/craft-wms/portal
# Образ с бандлом портала: собирается CI при мерже в main и публикуется в GHCR.
# Пусто = портал не обновляется автоматически (бандл кладётся вручную).
PORTAL_IMAGE=ghcr.io/sergeismv/craft-wms-portal:main

# --- Авто-обновление (systemd-таймер на сервере) ---
# true  — сервер сам подтягивает новый образ и мигрирует по расписанию;
# false — обновлять только вручную (deploy/update.sh).
AUTO_UPDATE=true
UPDATE_INTERVAL=5min

# --- Доступ к приватному образу GHCR (НЕ нужно, если пакет публичный — рекомендуется) ---
# Заполнять только если образ в GHCR приватный. Токен — PAT со scope read:packages.
GHCR_USER=
GHCR_TOKEN=

# --- PostgreSQL ---
POSTGRES_USER=wms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=craft_wms

# --- Backend ---
LOG_LEVEL=info
JWT_SECRET=CHANGE_ME
ACCESS_TTL=12h
REFRESH_TTL=720h

# --- Стартовый админ (заводится при первом деплое) ---
ADMIN_BADGE=1000000012345678
ADMIN_FULL_NAME=Администратор
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- Ресурсные лимиты ---
DB_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=256m

# SELF_UPDATE=false — update.sh не будет обновлять сам код деплоя (git pull) и юниты;
# тогда правки скриптов доставляются на сервер вручную.
SELF_UPDATE=true

# --- Бэкап БД (systemd-таймеры, ставит deploy/install.sh) ---
# AUTO_BACKUP=false отключит бэкап по расписанию — тогда БД остаётся единственной копией данных.
AUTO_BACKUP=true
# Формат расписания — systemd OnCalendar (man systemd.time).
BACKUP_SCHEDULE=*-*-* 03:30:00
# Проверка восстановимости: разворачивает последний дамп во временную базу и удаляет её.
RESTORE_CHECK_SCHEDULE=Sun *-*-* 04:30:00
# Сколько дней хранить дампы (ротация в pg-backup.sh).
KEEP_DAYS=14
# Дамп перед миграциями при обновлении (update.sh): каталог и сколько последних хранить.
# Пусто = /opt/craft-wms/premigrate и 5. Наружу не уходит, ночная ротация его не трогает.
PREMIGRATE_DIR=
PREMIGRATE_KEEP=5

# --- Мониторинг (ADHOC-42) ---
# Сбор ошибок бэкенда — Bugsink на поддомене. Пока BUGSINK_SECRET_KEY пуст, контейнеры Bugsink
# не поднимаются, а бэкенд без SENTRY_DSN ничего не отправляет: стек — как до мониторинга.
#
# Поддомен интерфейса: DNS-запись на тот же IP, что у DEPLOY_DOMAIN. Сертификат и vhost
# выпускает deploy/install.sh (шаг setup_bugsink_vhost), CERTBOT_EMAIL — тот же.
BUGSINK_DOMAIN=
# Секрет приложения — сгенерировать: openssl rand -base64 50
BUGSINK_SECRET_KEY=
# Пароль своей базы Bugsink — сгенерировать: openssl rand -hex 24
BUGSINK_DB_PASSWORD=
# Первый вход в интерфейс: «почта:пароль». Учётка заводится один раз, при пустой базе.
BUGSINK_ADMIN=
# Образ — версия закреплена мажорной меткой.
BUGSINK_IMAGE=bugsink/bugsink:2
# Где слушает контейнер (только loopback — снаружи его открывает nginx).
BUGSINK_BIND=127.0.0.1:8001
# Письма об ошибках — SMTP-ящик для алертов (только алерты; документы почтой не ходят).
BUGSINK_EMAIL_HOST=
BUGSINK_EMAIL_PORT=587
BUGSINK_EMAIL_USER=
BUGSINK_EMAIL_PASSWORD=
BUGSINK_EMAIL_USE_TLS=True
BUGSINK_EMAIL_USE_SSL=False
BUGSINK_EMAIL_FROM=
# DSN проекта из интерфейса Bugsink, но с ВНУТРЕННИМ адресом: http://<ключ>@bugsink:8000/<номер>.
# Пусто — бэкенд ошибки не отправляет.
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod

# Сигналы таймеров во внешний сервис — адрес монитора. Формат выбирается по адресу:
#   Cronitor:        https://cronitor.link/p/<ключ>/<монитор>
#   Healthchecks.io: https://hc-ping.com/<uuid>
# Пусто — сигнал не отправляется. UPDATE заодно говорит «сервер жив»: его ждут каждые 5 минут.
JOB_PING_UPDATE=
JOB_PING_BACKUP=
JOB_PING_RESTORE_CHECK=

# --- Шифрование дампов ---
# В дампе ФИО сотрудников, логины и хеши паролей — наружу он должен уезжать только шифрованным.
# Пусто = шифрования нет, и тогда внешняя копия НЕ отправляется вовсе: выносить незашифрованное
# хуже, чем не выносить.
#
# Просто длинная парольная фраза. Ключевых файлов здесь намеренно нет: файл-ключ надо где-то
# хранить и не потерять, а потерянный ключ убивает бэкапы так же надёжно, как их отсутствие.
# Сгенерировать: openssl rand -base64 32
#
# ⚠ ЗАПИШИТЕ ЭТУ ФРАЗУ ВНЕ СЕРВЕРА (менеджер паролей). Этот файл живёт только на сервере;
# если он погибнет вместе с диском, внешняя копия останется нечитаемой — то есть её нет.
# ⚠ Меняя фразу, вы теряете доступ к УЖЕ СНЯТЫМ дампам: они зашифрованы старой.
BACKUP_PASSPHRASE=

# --- Внешняя копия дампов ---
# Можно задать обе переменные — тогда копия уедет в два места. Обе пустые = копии нет,
# дампы лежат только на диске сервера (в journal пишется ошибка).
#
# rsync-назначение: локальный путь смонтированного внешнего диска ИЛИ user@host:/path.
# rsync эти формы не различает. Каталог должен быть ВЫДЕЛЕННЫМ под дампы: внутри работает
# зеркалирование ротации (--delete по нашему шаблону имён).
OFFSITE_DEST=
# Ключ для rsync по SSH (нужен только для формы user@host:/path).
OFFSITE_SSH_KEY=
#
# --- Яндекс.Диск (рекомендуемый способ хранить копию вне сервера) ---
# Заполняется мастером: панель управления → «Настроить бэкапы». Вручную тоже можно.
# Нужен НЕ пароль от аккаунта, а «пароль приложения» с доступом к файлам (WebDAV):
# создаётся в браузере на любом устройстве — https://id.yandex.ru/security/app-passwords
# Подключение собирается из этих значений на лету, файл конфигурации rclone не нужен.
YANDEX_LOGIN=
YANDEX_WEBDAV_PASSWORD=
# Папка на Диске (создаётся автоматически).
YANDEX_FOLDER=craft-wms-backups

# rclone-назначение для ДРУГИХ облаков (S3, произвольный WebDAV) — remote:path.
# Требует заранее настроенного remote в конфигурации rclone. Для Яндекс.Диска
# используйте переменные выше, они проще.
OFFSITE_RCLONE_REMOTE=
