# Шаблон vhost для ХОСТОВОГО nginx (не контейнерного). deploy/install.sh подставляет
# сюда домен, адрес backend и путь к бандлу портала через envsubst (только эти переменные;
# nginx-переменные вида $host не трогаются) и кладёт результат
# в /etc/nginx/sites-available/<домен>.
#
# Здесь только HTTP(:80). TLS-блок(:443) и редирект http->https добавит `certbot --nginx`
# при первом выпуске сертификата.
#
# Раскладка URL (ADR-0015): портал отдаётся с диска на корне, API живёт под /api/.
# Один origin - значит без CORS и с одним сертификатом. Пробы /health и /ready вынесены
# из /api/ намеренно: их дёргают снаружи и из docker-healthcheck, префикс версии им не нужен.

server {
    listen 80;
    listen [::]:80;
    server_name ${DEPLOY_DOMAIN};

    # Размер загружаемых файлов: через портал заливают .xls номенклатуры и .xlsx ячеек.
    client_max_body_size 32m;

    # --- API ---
    # proxy_pass БЕЗ завершающего слэша: префикс /api/ должен дойти до backend как есть,
    # он маршрутизирует /api/v1/... Со слэшем nginx срезал бы префикс, и все ручки дали бы 404.
    location /api/ {
        proxy_pass http://${BACKEND_BIND};

        # Пробрасываем реального клиента - нужно бэкенду для логов и rate limiting.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Пробы состояния ---
    location = /health {
        proxy_pass http://${BACKEND_BIND};
        proxy_set_header Host $host;
    }
    location = /ready {
        proxy_pass http://${BACKEND_BIND};
        proxy_set_header Host $host;
    }

    # --- Веб-портал оператора (статика Flutter Web) ---
    # try_files ... /index.html обязателен: маршрутизация у портала клиентская, и прямой
    # переход по внутреннему адресу без этого дал бы 404 от nginx.
    # Если бандл ещё не залит, каталога нет - API продолжит работать, портал отдаст 404.
    location / {
        root ${PORTAL_ROOT};
        try_files $uri $uri/ /index.html;
    }
}
