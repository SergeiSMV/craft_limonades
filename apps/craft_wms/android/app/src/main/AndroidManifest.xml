<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Доступ в сеть. Шаблон Flutter объявляет INTERNET только в debug- и profile-манифестах
         (там он нужен инструментам hot reload), в релиз он не попадает. Без него резолвер
         отказывает мгновенно: любой запрос падает с `Failed host lookup`, а приложение
         показывает «нет связи с сервером» при полностью исправной сети. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Печать этикеток на Bluetooth-принтере (P4-05).

      Разрешения разведены по версиям Android, потому что модель сменилась на API 31:
      до него Bluetooth-права выдаются при установке, а обнаружение устройств считается
      определением местоположения и требует ACCESS_FINE_LOCATION в рантайме; с 31 появились
      собственные BLUETOOTH_SCAN / BLUETOOTH_CONNECT, а геолокация больше не нужна.
      ТСД пилота — Android 11 (API 30), то есть живёт по первой модели; вторая объявлена,
      чтобы приложение не сломалось на терминале посвежее.

      neverForLocation у BLUETOOTH_SCAN — обещание системе, что сканирование не используется
      для определения местоположения. Это правда: мы ищем принтер.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Портрет закреплён здесь, а не только в main.dart (ADHOC-19, долг 5): вызов
             SystemChrome срабатывает уже после старта движка, и до него система успевала
             нарисовать окно в ландшафте — при запуске экран мелькал и перестраивался. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Определение аппаратного сканера (P2-01): на Android 11+ чужие пакеты не видны без
             явного объявления, и PackageManager.getPackageInfo вернул бы «не установлено» даже
             на ТСД. com.ubx.uscanner - служба декодера Urovo, com.ubx.barcodescanner.tool - её
             настройки; наличие любого из них означает, что сканер на устройстве есть. -->
        <!-- Ссылка на политику конфиденциальности с экрана входа (ADHOC-66): на Android 11+
             url_launcher видит браузер, только если запрос на открытие ссылки объявлен здесь. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <package android:name="com.ubx.uscanner"/>
        <package android:name="com.ubx.barcodescanner.tool"/>
    </queries>
</manifest>
