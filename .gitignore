# macOS
.DS_Store

# Временные/lock-файлы Microsoft Office (напр. ~$plan_v3.docx, пока документ открыт)
~$*

# Локальные dev-документы (не для репозитория)
# docs/ целиком локальный, кроме инструкций по развёртке на сервере (docs/deploy/)
docs/*
!docs/deploy/
dev.md
dev-context.md
dev-context-archive.md
version.md
scripts/roadmap_flatten.lua

# Environment / секреты — никогда не коммитим
.env
.env.local
.env.*.local
# боевые секреты прод-деплоя (шаблон — infra/.env.prod.example)
infra/.env.prod

# Бэкапы БД (deploy/pg-backup.sh)
/backups/

# Тестовый стенд (ADHOC-27): снимки боевой базы (ФИО, логины, хеши паролей) и локальные настройки
/deploy/test_stand/snapshots/
/deploy/test_stand/stand.env
/deploy/test_stand/cz/

# IDE (корневой уровень; Flutter-подпапка имеет свой .gitignore)
.idea/
.vscode/
*.iml

# CommandKit related
**/*.cmdk

# Go — бинари, случайно собранные `go build ./cmd/X` в корне модуля
/apps/backend/bin/
/apps/backend/server
/apps/backend/migrate
/apps/backend/seed
*.exe
*.out
*.test
*.prof
coverage.out

# Логи
*.log

# Локальные отчёты по репозиторию (делаются на машине разработчика, в репозиторий не идут)
/report.md
/report.docx
/git-report.sh

# Токен True API разведки ЧЗ (CZ-01) — секрет, не коммитить
scripts/cz-probe/.token
